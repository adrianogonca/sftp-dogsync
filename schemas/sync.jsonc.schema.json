{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DogSync connections",
  "type": "object",
  "additionalProperties": {
    "type": "array",
    "minItems": 1,
    "items": {
      "$ref": "#/definitions/connectionBlock"
    }
  },
  "definitions": {
    "connectionBlock": {
      "type": "object",
      "required": ["host", "port", "username"],
      "properties": {
        "protocol": {
          "type": "string",
          "enum": ["sftp", "ftp"],
          "default": "sftp"
        },
        "host": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "username": { "type": "string", "minLength": 1 },
        "ftpSecurityMode": {
          "type": "string",
          "enum": ["explicitFtps", "plainFtp"]
        },
        "trustFtpSelfSignedCertificate": { "type": "boolean" },
        "sshPasswordAuthentication": { "type": "boolean", "default": false },
        "privateKeyPath": { "type": "string" },
        "useSshAgent": { "type": "boolean", "default": false },
        "strictHostKeyChecking": { "type": "boolean", "default": false },
        "knownHostsPath": { "type": "string" },
        "remoteRoot": { "type": "string" },
        "localSubfolder": { "type": "string" },
        "uploadOnSave": { "type": "boolean", "default": true },
        "deleteRemoteOnLocalDelete": { "type": "boolean", "default": false },
        "ignorePatterns": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    }
  }
}
